from lxml import etree
from pathlib import Path

from django.conf import settings
from django.core.management.base import BaseCommand

from apps.parsing.utils import parse_and_resolve, extract_deadline, normalize_deadline
from apps.developers.models import Developer
from apps.projects.models import Project
from apps.houses.models import House
from apps.flats.models import Flat


class Command(BaseCommand):
    help = "Import XML feed"

    def add_arguments(self, parser):
        parser.add_argument("--file", type=str, default="test.xml")

    def handle(self, *args, **kwargs):
        file_name = kwargs["file"]
        feed_path = Path(settings.FEEDS_DIR) / file_name

        if not feed_path.exists():
            self.stderr.write(f"❌ File not found: {feed_path}")
            return

        parser = etree.XMLParser(recover=True)
        tree = etree.parse(str(feed_path), parser)
        root = tree.getroot()

        ns = {"y": "http://webmaster.yandex.ru/schemas/feed/realty/2010-06"}

        patterns = [
            r"Застройщик:\s*(.+?)(?:\.\s|$)",
            r"Застройщик\s*-\s*(.+?)(?:\.\s|$)",
        ]

        normalize_rules = ["ООО", "ГК", "ЗАО"]

        for offer in root.findall("y:offer", ns):

            # ------------------------
            # BASIC DATA
            # ------------------------
            external_flat_id = offer.get("internal-id")

            description_el = offer.find("y:description", ns)
            description = description_el.text if description_el is not None else ""

            # ------------------------
            # DEVELOPER
            # ------------------------
            developer = parse_and_resolve(
                model=Developer,
                text=description,
                patterns=patterns,
                normalize_rules=normalize_rules
            )

            # ------------------------
            # PROJECT
            # ------------------------
            project_name = self.get_text(offer, "y:building-name", ns)
            project_external_id = self.get_text(offer, "y:nmarket-complex-id", ns)

            project, _ = Project.objects.get_or_create(
                external_id=project_external_id,

                defaults={
                    "name": project_name,
                    "developer": developer
                }
            )

            if developer and project.developer != developer:
                project.developer = developer
                project.save(update_fields=["developer"])

            # ------------------------
            # HOUSE
            # ------------------------
            house_external_id = self.get_text(offer, "y:nmarket-building-id", ns)

            address = self.get_nested_text(offer, "y:location/y:address", ns)
            corpus = self.get_text(offer, "y:building-section", ns)
            phase = self.get_text(offer, "y:building-phase", ns)
            floors = self.to_int(self.get_text(offer, "y:floors-total", ns))

            deadline_raw = extract_deadline(description)
            deadline = normalize_deadline(deadline_raw)

            house, _ = House.objects.get_or_create(
                external_id=house_external_id,
                defaults={
                    "project": project,
                    "address": address,
                    "corpus": corpus,
                    "phase": phase,
                    "floors": floors,
                    "deadline": deadline,
                }
            )

            if deadline and house.deadline != deadline:
                house.deadline = deadline
                house.save(update_fields=["deadline"])



            # ------------------------
            # FLAT
            # ------------------------
            rooms = self.to_int(self.get_text(offer, "y:rooms", ns))
            area = self.to_float(self.get_nested_text(offer, "y:area/y:value", ns))
            floor = self.to_int(self.get_text(offer, "y:floor", ns))

            Flat.objects.update_or_create(
                external_id=external_flat_id,
                defaults={
                    "house": house,
                    "rooms": rooms,
                    "rooms_alias": f"{rooms}к" if rooms else None,
                    "square": area,
                    "floor": floor
                }
            )

            self.stdout.write(f"✔ Flat {external_flat_id}")

    # ------------------------
    # HELPERS
    # ------------------------

    def get_text(self, parent, path, ns):
        el = parent.find(path, ns)
        return el.text.strip() if el is not None and el.text else None

    def get_nested_text(self, parent, path, ns):
        el = parent.find(path, ns)
        return el.text.strip() if el is not None and el.text else None

    def to_int(self, value):
        try:
            return int(value)
        except:
            return None

    def to_float(self, value):
        try:
            return float(value)
        except:
            return None
